# Assessment Studio isolated local-development configuration.
# The application does not load this file automatically. Export these values
# before the first import/startup, and never expose placeholder credentials.
SECRET_KEY=replace-with-a-long-random-value
INSTITUTION_NAME=Your Institution
PORT=5000
FLASK_DEBUG=0

# Cookies are secure by default when this variable is absent. This explicit 0
# is ONLY for isolated local HTTP. Use 1 behind HTTPS/TLS in production.
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# POSTGRES_PASSWORD is raw text consumed by the PostgreSQL container.
# DATABASE_URL is a separate URI: percent-encode reserved password characters
# such as @, :, /, %, # and ?. Never paste a raw complex password into the URI.
DATABASE_URL=postgresql://assessment:replace-with-url-encoded-db-password@db:5432/assessment
POSTGRES_DB=assessment
POSTGRES_USER=assessment
POSTGRES_PASSWORD=replace-with-the-raw-db-password
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=10

# First administrator. Used only when the teachers table is empty.
# Replace every placeholder; these values are not safe for shared networks or production.
TEACHER_ADMIN_NAME=Local Administrator
TEACHER_ADMIN_EMAIL=local-admin@example.invalid
TEACHER_ADMIN_PASSWORD=replace-with-a-strong-local-password-123

# Container runtime tuning
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
APP_PORT=5000
APP_BIND_IP=127.0.0.1
AUDIO_DIR=/app/static/audio
